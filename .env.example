# AutoMunki Configuration
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://automunki:automunki@localhost:5432/automunki

# Security - CHANGE THIS IN PRODUCTION
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Debug mode
DEBUG=false

# GitHub Integration
GITHUB_TOKEN=
GITHUB_REPO=your-org/automunki

# AWS / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=

# Notifications
SLACK_WEBHOOK_URL=

# Public URL for the API (used in GitHub Actions workflow dispatch)
# Set this to your ngrok/tunnel URL when testing, e.g. https://xxxx.ngrok-free.app
# Must point to the backend (port 8000), not the frontend
API_PUBLIC_URL=

# CORS
CORS_ORIGINS=["http://localhost:3000"]
