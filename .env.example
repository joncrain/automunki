# AutoMunki Configuration
# Copy this to .env and fill in your values

# Database
# Local: postgresql+asyncpg://automunki:automunki@localhost:5432/automunki
# Neon:  postgresql+asyncpg://user:pass@ep-xxx-yyy-123456.us-east-2.aws.neon.tech/automunki?sslmode=require
DATABASE_URL=postgresql+asyncpg://automunki:automunki@localhost:5432/automunki

# Security - CHANGE THIS IN PRODUCTION
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Debug mode
DEBUG=false

# GitHub Integration
GITHUB_TOKEN=
GITHUB_REPO=your-org/automunki

# Default AutoPkg runner when the UI does not choose one: github | local
# local = only register the run; execute on a Mac (see docs/local-autopkg-runner.md)
AUTOPKG_RUNNER_MODE=github

# AWS / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=

# Notifications
SLACK_WEBHOOK_URL=

# Public URL (used in GitHub Actions workflow dispatch)
# Set this to your ngrok/tunnel URL when testing, e.g. https://xxxx.ngrok-free.app
# With the Next.js proxy, this is the single URL for both frontend and API (port 3000)
API_PUBLIC_URL=

# Backend URL (used by Next.js to proxy /api/* requests)
# Default: http://localhost:8000 — only change if the backend runs on a different host
# BACKEND_URL=http://localhost:8000

# CORS (only needed if frontend and backend are on different origins)
# With the Next.js proxy, CORS is not required for normal operation
CORS_ORIGINS=["http://localhost:3000"]

# Optional: directory for uploaded UI software icons (PNG). When unset, the API
# looks for <repo>/frontend/public/icons (same folder Next serves as /icons/*).
# UI_ICONS_DIRECTORY=
